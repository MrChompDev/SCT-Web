# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ───────────────────────────────────
# Paste these AFTER creating your project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Discord Webhooks (Server Settings → Integrations → Webhooks) ───────
# Copy the webhook URL for each channel
DISCORD_WEBHOOK_ANNOUNCEMENTS=
DISCORD_WEBHOOK_APPLICATIONS=
DISCORD_WEBHOOK_ADMIN_LOGS=

# ── Discord OAuth (optional — for "Continue with Discord" login) ────────
# Create an application at https://discord.com/developers, then enable the
# Discord provider in Supabase → Authentication → Providers with these keys.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
