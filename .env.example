# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ───────────────────────────────────
# Paste these AFTER creating your project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
# The anon key — newer Supabase projects label it the "publishable key".
# Either env name works; you only need one of the two:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# REQUIRED for the newsletter auto-post webhook (bypasses RLS server-side).
# Newer projects call this the "secret key" (sb_secret_…) — either name works.
# Never expose this in the browser — server-side only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ── Newsletter auto-post webhook (inbound) ───────────────────────────────
# Shared secret for POST /api/webhooks/newsletters — generate with:
#   openssl rand -hex 24
# Send it as `Authorization: Bearer <secret>`, `x-webhook-secret` header,
# or `?secret=` query param. Leave empty to disable the webhook.
NEWSLETTER_WEBHOOK_SECRET=

# ── Discord Webhooks (Server Settings → Integrations → Webhooks) ───────
# Copy the webhook URL for each channel
DISCORD_WEBHOOK_ANNOUNCEMENTS=
DISCORD_WEBHOOK_ADMIN_LOGS=
# Legacy — the public apply form now lives at melonly.xyz, so this is only
# used if you wire applications back up:
DISCORD_WEBHOOK_APPLICATIONS=

# ── Discord OAuth (for "Continue with Discord" login) ──────────────────
# 1. Create an application at https://discord.com/developers → OAuth2
#    and add this redirect: https://vlxwhqhjfwntaqmmorny.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → Discord: enable + paste the
#    client ID and secret.
# 3. Paste the same values here — the Discord button only shows when both
#    are present.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
